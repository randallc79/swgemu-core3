# =========================
# STAGE 1 — BUILD CORE3
# =========================
FROM debian:12 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt update && apt install -y \
    build-essential \
    cmake \
    clang-16 \
    lld-16 \
    git \
    openjdk-17-jdk-headless \
    libatomic1 \
    libssl-dev \
    zlib1g-dev \
    libbz2-dev \
    liblzma-dev \
    libreadline-dev \
    libncurses5-dev \
    uuid-dev \
    libexpat1-dev \
    libcurl4-openssl-dev \
    default-libmysqlclient-dev \
    mariadb-client \
    lua5.3 \
    liblua5.3-dev \
    libdb5.3-dev \
    libboost-all-dev \
    screen \
    libboost-thread-dev \
    libboost-system-dev \
    libboost-filesystem-dev \
    libboost-program-options-dev \
    libboost-regex-dev \
    libboost-date-time-dev \
    liblua5.3-0 \
    && rm -rf /var/lib/apt/lists/*

ENV CC=clang-16
ENV CXX=clang++-16

WORKDIR /build

RUN git clone --branch unstable https://github.com/swgemu/Core3.git
WORKDIR /build/Core3/MMOCoreORB
RUN git submodule update --init --recursive

RUN cmake \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_C_FLAGS="-march=x86-64-v2" \
  -DCMAKE_CXX_FLAGS="-march=x86-64-v2" \
  . \
 && make -j$(nproc)

# =========================
# STAGE 2 — RUNTIME IMAGE
# =========================
FROM debian:12

ENV DEBIAN_FRONTEND=noninteractive
ENV HOME_DIR=/home/swgemu
ENV RUN_USER=swgemu

RUN apt update && apt install -y \
    openjdk-17-jre-headless \
    mariadb-server \
    mariadb-client \
    pwgen \
    libatomic1 \
    screen \
    figlet \
    rsync \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

# create users Core3 expects
RUN id swgemu >/dev/null 2>&1 || useradd -m -u 44400 swgemu \
 && id mysql  >/dev/null 2>&1 || true

# MariaDB runtime dirs (Debian init expects these)
RUN mkdir -p /var/lib/mysql /run/mysqld \
 && chown -R mysql:mysql /var/lib/mysql /run/mysqld

WORKDIR /home/swgemu

# copy Core3 build
RUN mkdir -p /home/swgemu/workspace
COPY --from=builder /build/Core3 /home/swgemu/workspace/Core3

# runtime scripts (unchanged Core3 behavior)
COPY files/ /home/swgemu/

RUN chown -R swgemu:swgemu /home/swgemu

# expose firstboot where run.sh expects it
RUN mkdir -p /firstboot \
 && cp -r /home/swgemu/firstboot/* /firstboot/ \
 && chown -R swgemu:swgemu /home/swgemu /firstboot

# required so /etc/init.d/mariadb works
VOLUME ["/var/lib/mysql"]

CMD ["/home/swgemu/run.sh"]
