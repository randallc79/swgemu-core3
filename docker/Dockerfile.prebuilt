# =========================
# STAGE 1 — BUILD CORE3
# =========================
FROM debian:12 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt update && apt install -y \
    build-essential \
    cmake \
    clang-16 \
    lld-16 \
    git \
    openjdk-17-jdk-headless \
    libatomic1 \
    libssl-dev \
    zlib1g-dev \
    libbz2-dev \
    liblzma-dev \
    libreadline-dev \
    libncurses5-dev \
    uuid-dev \
    libexpat1-dev \
    libcurl4-openssl-dev \
    default-libmysqlclient-dev \
    mariadb-client \
    lua5.3 \
    liblua5.3-dev \
    libdb5.3-dev \
    libboost-all-dev \
    screen \
    && rm -rf /var/lib/apt/lists/*

ENV CC=clang-16
ENV CXX=clang++-16

WORKDIR /build

# clone Core3
RUN git clone --branch unstable https://github.com/swgemu/Core3.git

WORKDIR /build/Core3/MMOCoreORB

# init submodules
RUN git submodule update --init --recursive

# configure + build
RUN cmake -DCMAKE_BUILD_TYPE=Release . \
 && make -j$(nproc)

# =========================
# STAGE 2 — RUNTIME IMAGE
# =========================
FROM debian:12

ENV DEBIAN_FRONTEND=noninteractive
ENV HOME_DIR=/config/swgemu
ENV RUN_USER=swgemu

RUN apt update && apt install -y \
    openjdk-17-jre-headless \
    mariadb-client \
    libatomic1 \
    screen \
    figlet \
    rsync \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

# create user
RUN useradd -m -u 44400 swgemu

WORKDIR /home/swgemu

# copy built artifacts
COPY --from=builder /build/Core3 /home/swgemu/Core3

# runtime scripts (unchanged behavior)
COPY files/ /home/swgemu/

RUN chown -R swgemu:swgemu /home/swgemu

# expose firstboot where run.sh expects it
RUN mkdir -p /firstboot \
 && cp -r /home/swgemu/firstboot/* /firstboot/ \
 && chown -R swgemu:swgemu /home/swgemu /firstboot

CMD ["/home/swgemu/run.sh"]
